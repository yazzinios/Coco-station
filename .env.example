# =============================================================================
# CocoStation — Environment Variables
# Copy this file to .env and fill in the values before starting.
# =============================================================================

# Database mode: "local" (Postgres container) or "cloud" (Supabase)
DB_MODE=local

# JWT secret — REQUIRED, must be set or the API will refuse to start.
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-strong-random-secret

# CORS — origins allowed to call the API (comma-separated, no trailing slash)
# For production set this to your public domain.
CORS_ORIGINS=https://radio.cocopark.duckdns.org

# Local PostgreSQL (used when DB_MODE=local)
POSTGRES_USER=coco
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cocostation

# Cloud Supabase (used when DB_MODE=cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-publishable-key-here

# MediaMTX
MEDIAMTX_HOST=mediamtx

# DJ stream credentials — required for OBS/broadcaster to publish to dj-* RTMP paths.
# Set a strong password and configure the same in your OBS stream key.
# Format for OBS stream key: rtmp://your-server:1935/dj-a  user: dj  pass: <MEDIAMTX_DJ_PASS>
MEDIAMTX_DJ_USER=dj
MEDIAMTX_DJ_PASS=CHANGE_ME_STRONG_DJ_PASSWORD
