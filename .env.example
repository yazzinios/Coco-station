# Database mode: "local" or "cloud"
DB_MODE=local

# JWT secret — REQUIRED, must be set before starting the server
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-strong-random-secret

# Local PostgreSQL
POSTGRES_USER=coco
POSTGRES_PASSWORD=coco_secret
POSTGRES_DB=cocostation

# Cloud Supabase (fill when DB_MODE=cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-publishable-key-here

# MediaMTX
MEDIAMTX_HOST=mediamtx
